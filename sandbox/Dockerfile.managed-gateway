FROM python:3.13.18-slim-trixie
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iptables openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir dnslib==0.9.26 mitmproxy==12.3.1
WORKDIR /app
COPY sandbox /app/sandbox
COPY truman /app/truman
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
CMD ["sh", "/app/sandbox/transparent-router.sh"]
