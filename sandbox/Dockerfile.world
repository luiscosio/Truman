FROM python:3.13.18-slim-trixie
# squid serves the legacy sandbox mode.
RUN apt-get update && apt-get install -y --no-install-recommends openssl squid \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir mwparserfromhell==0.7.2 lxml==6.1.3
WORKDIR /app
COPY truman /app/truman
COPY sandbox /app/sandbox
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "sandbox.wikipedia"]
