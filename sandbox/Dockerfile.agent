# The same base as every Truman image; it brings Python 3.13 (python3) on Debian Trixie.
FROM python:3.13.18-slim-trixie
ARG CLAUDE_VERSION=2.1.317
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl bash git ripgrep \
    && rm -rf /var/lib/apt/lists/*
# The installer keeps its own copy of the binary; move it rather than copy, and drop the rest.
RUN curl -fsSL https://claude.ai/install.sh -o /tmp/install-claude.sh \
    && bash /tmp/install-claude.sh "$CLAUDE_VERSION" \
    && mv "$(readlink -f /root/.local/bin/claude)" /usr/local/bin/claude \
    && rm -rf /root/.local /root/.cache /root/.claude /tmp/install-claude.sh /tmp/cc-socks
RUN useradd -m -u 10001 agent && mkdir /workspace && chown agent:agent /workspace
COPY sandbox/agent-entrypoint.sh /usr/local/bin/agent-entrypoint
RUN chmod 755 /usr/local/bin/agent-entrypoint
USER agent
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
CMD ["claude", "--version"]
